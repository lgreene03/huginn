# Compiled Go Binaries (anchored to repo root so cmd/{huginn,backtest,fetcher}/
# source directories remain tracked — pre-2026-05 these patterns matched paths
# anywhere and silently excluded every cmd/*.go file from version control).
/huginn
/backtest
/fetcher
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Web Dependencies & Builds
web/node_modules/
web/dist/
web/.svelte-kit/
web/build/
.env
.env.local

# Local Data and Logs
#
# data/btc_test.jsonl is intentionally NOT ignored: it is the ~550KB test
# fixture the research gateway (cmd/research) and walk-forward replay read, and
# it is committed so `clone -> run` works config-free.
data/trades.jsonl
data/backtest_trades.jsonl
data/costsweep_trades.jsonl
data/walkforward_results.json
# Bulk backfills built by `fetcher --source vision`. btc_test.jsonl (24h) stays
# checked in as the small reproducible fixture; multi-month pulls are tens of MB
# and are regenerated on demand, so they are not versioned.
data/btc_*mo.jsonl
data/historical_features.jsonl
# cmd/research writes one run-result JSON per run here — never committable.
data/research/
data/pg_data/
*.db
*.log

