# Go 1.26.11, matching go.mod and the main Dockerfile. The official image sets
# GOTOOLCHAIN=local, so the builder must be at least go.mod's version: the old
# golang:1.25-alpine pin (go1.25.10, amd64 only) could no longer build this
# module once go.mod moved to 1.26. The tag names the version; the digest pins
# the bytes of the multi-arch index.
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS builder
WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-w -s \
        -X github.com/lgreene03/huginn/internal/version.Version=${VERSION} \
        -X github.com/lgreene03/huginn/internal/version.GitSHA=${GIT_SHA} \
        -X github.com/lgreene03/huginn/internal/version.BuildTime=${BUILD_TIME}" \
      -o research ./cmd/research

FROM alpine:3.20@sha256:c64c687cbea9300178b30c95835354e34c4e4febc4badfe27102879de0483b5e
WORKDIR /app

RUN apk --no-cache add ca-certificates tzdata

# Run as an unprivileged user rather than root. Create a dedicated app user and
# own the working dir so the binary and bundled dataset are readable at runtime.
RUN addgroup -S research && adduser -S -G research -H -h /app research

COPY --from=builder --chown=research:research /app/research .

# The historical dataset (RESEARCH_DATA_PATH, default data/btc_test.jsonl) and
# the persisted-runs dir (RESEARCH_RESULTS_DIR, default data/research) both live
# under /app/data, which is .dockerignored from the build context — so it is NOT
# baked into the image. Mount ./data as a volume at runtime; the research service
# compose block lives in the norse-stack repo
# (https://github.com/lgreene03/norse-stack). Pre-create + own the dir so the
# unprivileged user can write run artifacts even on an empty mount.
RUN mkdir -p /app/data/research && chown -R research:research /app/data

USER research

EXPOSE 8094

CMD ["./research"]
